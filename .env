# Nifty 100 Financial Intelligence Platform — local environment config.
# See Section 19 (Project Directory Structure) of the project spec.
# Not committed to git (see .gitignore).

DB_PATH=data/nifty100.db
PORT=8000
LOG_LEVEL=INFO

# stock_prices.xlsx and market_cap.xlsx are simulated (see Section 6.2 /
# 6.3 and Risk R-06) — the dashboard/reports use this flag to label any
# chart or table built from them accordingly.
SIMULATED_DATA_FLAG=true
