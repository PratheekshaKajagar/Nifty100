    "/api/v1/screener": {
      "get": {
        "tags": [
          "screener"
        ],
        "summary": "Run Screener",
        "description": "Day 40 - ad-hoc screener endpoint mirroring the dashboard's\nslider filters. Every parameter is optional; omitted ones are not\nfiltered on. Returns HTTP 400 for a parameter that isn't a valid\nnumber (FastAPI's own float coercion already rejects most of\nthese, but NaN - which parses fine as a float - is rejected here\nexplicitly).",
        "operationId": "run_screener_api_v1_screener_get",
        "parameters": [
          {
            "name": "min_roe",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Minimum return_on_equity_pct",
              "title": "Min Roe"
            },
            "description": "Minimum return_on_equity_pct"
          },
          {
            "name": "max_de",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Maximum debt_to_equity",
              "title": "Max De"
            },
            "description": "Maximum debt_to_equity"
          },
          {
            "name": "min_fcf",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Minimum free_cash_flow_cr",
              "title": "Min Fcf"
            },
            "description": "Minimum free_cash_flow_cr"
          },
          {
            "name": "sector",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Filter to a single broad_sector",
              "title": "Sector"
            },
            "description": "Filter to a single broad_sector"
          },
          {
            "name": "min_rev_cagr_5yr",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Minimum 5yr revenue CAGR (%)",
              "title": "Min Rev Cagr 5Yr"
            },
            "description": "Minimum 5yr revenue CAGR (%)"
          },
          {
            "name": "min_pat_cagr_5yr",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Minimum 5yr PAT CAGR (%)",
              "title": "Min Pat Cagr 5Yr"
            },
            "description": "Minimum 5yr PAT CAGR (%)"
          },
          {
            "name": "max_pe",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Maximum P/E ratio",
              "title": "Max Pe"
            },
            "description": "Maximum P/E ratio"
          }
        ],
